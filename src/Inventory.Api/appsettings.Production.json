{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Error",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=__REPLACE_WITH_SQL_SERVER__;Database=InventoryDb;User Id=__REPLACE_WITH_USER__;Password=__REPLACE_WITH_PASSWORD__;Encrypt=true;TrustServerCertificate=false;"
  },
  "Jwt": {
    "Secret": "__REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS__",
    "Issuer": "inventory-api",
    "Audience": "inventory-api-users",
    "ExpirationMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": ["__REPLACE_WITH_YOUR_FRONTEND_ORIGIN__"]
  },
  "Serilog": {
    "MinimumLevel": "Warning",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/inventory-api/inventory-api-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ]
  },
  "AllowedHosts": "api.example.com"
}
