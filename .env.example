# SQL Server Configuration
MSSQL_SA_PASSWORD=YourPassword123!
MSSQL_PID=Express
MSSQL_SERVER=localhost,1433
MSSQL_DATABASE=InventoryDb
MSSQL_USER=sa

# .NET Application
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:8080

# Connection String
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=InventoryDb;User Id=sa;Password=YourPassword123!;TrustServerCertificate=true;

# JWT Configuration
Jwt__Secret=your-super-secret-key-min-32-characters-for-dev-only
Jwt__Issuer=inventory-api
Jwt__Audience=inventory-api-users
Jwt__ExpirationMinutes=60

# Logging
Serilog__MinimumLevel=Information
LOG_LEVEL=Information

# CORS allowed origins. .NET's env var config provider binds arrays via
# indexed keys (Key__0, Key__1, ...), not a comma-separated value.
Cors__AllowedOrigins__0=http://localhost:4200
Cors__AllowedOrigins__1=http://localhost:3000
